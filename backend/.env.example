# Copy to .env for local runs. In the droplet deployment these are supplied by
# docker-compose.yml / the .env file next to it instead - never commit a real .env.

# Postgres (docker-compose runs Postgres in its own "db" container on the droplet;
# for local development point this at a Postgres you have running yourself)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=atmabandhu

# Random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: forgot-password emails. Leave both unset and the OTP is logged to the
# server console / returned in the response instead of emailed.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=

PORT=5000

# Optional: powers Claude-based case-level triage (services/caseLevelClassifier.js)
# for routing complaints to officers by seniority. Get one at console.anthropic.com
# (Settings -> API Keys). Without it, a plain keyword heuristic is used instead -
# the feature still works, just less accurately.
ANTHROPIC_API_KEY=
